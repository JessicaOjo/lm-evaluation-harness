tag:
- lid_tasks
dataset_path: openlanguagedata/flores_plus
dataset_kwargs: {trust_remote_code: True}
output_type: generate_until
validation_split: dev
fewshot_split: dev
test_split: devtest
metric_list:
  - metric: f1
    aggregation: !function utils.calculate_f1
  - metric: acc
    aggregation: !function utils.calculate_acc
generation_kwargs:
  until:
    - </s>
  do_sample: false
  temperature: 0.0
filter_list:
  - name: remove_whitespace
    filter:
      - function: remove_whitespace
repeats: 1
metadata:
  version: 1.0
